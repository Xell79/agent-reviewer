#!/usr/bin/env python3
"""Lightweight JSON linter — validates syntax and optionally formats.

Usage:
  json-lint <file> [file...]           # validate only
  json-lint --format <file>            # validate and pretty-print
  json-lint --check <file>             # validate silently (exit 0 or 1)

Exit codes:
  0 = all files valid
  1 = at least one invalid
  2 = file not found
"""
import json
import sys
from pathlib import Path


def lint_file(path: Path, *, format_mode: bool = False, check_mode: bool = False) -> bool:
    """Returns True if valid, False if invalid."""
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        if check_mode:
            return True
        if format_mode:
            print(json.dumps(data, indent=2, ensure_ascii=False))
        else:
            print(f"✓ {path}")
        return True
    except FileNotFoundError:
        print(f"✗ {path}: file not found", file=sys.stderr)
        return False
    except json.JSONDecodeError as e:
        print(f"✗ {path}:{e.lineno}:{e.colno}: {e.msg}", file=sys.stderr)
        return False
    except Exception as e:
        print(f"✗ {path}: {e}", file=sys.stderr)
        return False


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"-h", "--help"}:
        print(__doc__)
        return 0

    format_mode = False
    check_mode = False
    if args[0] == "--format":
        format_mode = True
        args = args[1:]
    elif args[0] == "--check":
        check_mode = True
        args = args[1:]

    if not args:
        print("error: no files specified", file=sys.stderr)
        return 2

    results = [lint_file(Path(p), format_mode=format_mode, check_mode=check_mode) for p in args]
    return 0 if all(results) else 1


if __name__ == "__main__":
    sys.exit(main())
